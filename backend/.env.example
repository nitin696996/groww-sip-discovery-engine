# Groww Behavioral Discovery Engine Configuration
# You can supply comma-separated keys for any provider to multiply free-tier RPM/RPD quotas!

# 1. LLM Providers (Zero/Low Cost Pool)
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
OPENROUTER_API_KEYS=
GROK_API_KEYS=
GROQ_API_KEYS=

# 2. Ingestion Source Keys (Optional - Public zero-key scrapers work out of the box)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=groww-discovery-engine/1.0
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# 3. Target Identifiers
GROWW_PLAY_APP_ID=com.nextbillion.groww
GROWW_IOS_APP_ID=1404871703
GROWW_IOS_APP_NAME=groww-stocks-mutual-fund

# 4. Backend-Only Supabase Storage (Never exposed to frontend)
# Supports both the 2026 Supabase Secret Key (sb_secret_...) and legacy service_role key:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=sip_pipeline_rows

